APP_NAME=WeDo API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DOCS_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://wedo:wedo@db:5432/wedo
JWT_SECRET_KEY=development-only-change-me-32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:8081
MOBILE_SCHEME=wedo
GOOGLE_WEB_CLIENT_ID=
# Web account-deletion requests: HTTPS email delivery (works on Railway Hobby).
RESEND_API_KEY=
SUPPORT_SENDER_EMAIL=contact@durangezer.com
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
METADATA_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ==============================================================================
# CANLI (PRODUCTION) ORTAMI İÇİN GEREKLİ DEĞERLER (Örnek: Railway / Render):
# ENVIRONMENT=production
# DEBUG=false
# DOCS_ENABLED=false
# JWT_SECRET_KEY= (Terminalde 'openssl rand -hex 32' ile üretilmiş 64 karakterli rastgele anahtar)
# DATABASE_URL= (Canlı PostgreSQL bağlantı dizesi)
# CORS_ORIGINS=["https://wedo.app"]
# PUBLIC_INVITE_BASE_URL=https://wedo-production-3ad2.up.railway.app (veya https://wedo.app)
# ==============================================================================
